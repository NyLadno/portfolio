---
import { typo } from "../lib/typo";
import GithubActivity from "./GithubActivity.astro";
import ProjectLyceum from "./ProjectLyceum.astro";
import ProjectTracker from "./ProjectTracker.astro";
import ProjectTradebot from "./ProjectTradebot.astro";
---
<section id="projects" class="section" aria-labelledby="projects-title">
  <div class="wrap">
    <header class="section-head">
      <h2 id="projects-title">Проекты</h2>
      <p>{typo("Что я реально написал и как это устроено. Схемы нарисованы по коду репозиториев.")}</p>
    </header>
    <GithubActivity />
    <ProjectLyceum />
    <ProjectTracker />
    <ProjectTradebot />
  </div>
</section>

<style is:global>
  .project {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    row-gap: 32px;
    scroll-margin-top: 90px;
  }
  .project ~ .project {
    margin-top: clamp(88px, 11vw, 168px);
  }
  .project__num {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-display);
    font-size: 15px;
    letter-spacing: 0.02em;
    color: var(--graphite);
  }
  .project__num::after {
    content: "";
    width: 36px;
    height: 1.5px;
    background: currentColor;
  }
  .project__title {
    margin-top: 14px;
    font-size: clamp(32px, 4.2vw, 58px);
    letter-spacing: -0.035em;
    line-height: 1;
  }
  .project__desc {
    margin-top: 20px;
    max-width: 52ch;
    font-size: 17px;
  }
  .project__desc + .project__desc {
    margin-top: 12px;
  }
  .project .tags {
    margin-top: 24px;
  }
  .project__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
    margin-top: 28px;
  }
  .project__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    font-size: 13px;
    color: var(--graphite);
    transition:
      opacity 0.3s ease,
      transform 0.35s var(--ease-out);
  }
  .project__meta b {
    color: var(--ink);
    font-weight: 600;
  }
  .project__hint {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--graphite);
    margin-top: 12px;
    transition:
      opacity 0.3s ease 0.05s,
      transform 0.35s var(--ease-out) 0.05s;
  }

  /* визуальная панель проекта: на hover приподнимается с жёсткой тенью */
  .panel {
    position: relative;
    border: 1.5px solid var(--ink);
    border-radius: var(--r-card);
    background: var(--paper);
    transition:
      transform 0.35s var(--ease-out),
      box-shadow 0.35s var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .project:hover .panel--lift {
      transform: translate(-6px, -6px);
      box-shadow: 6px 6px 0 var(--juice);
    }
    .project .project__meta,
    .project .project__hint {
      opacity: 0;
      transform: translateY(6px);
    }
    .project:hover .project__meta,
    .project:hover .project__hint,
    .project:focus-within .project__meta,
    .project:focus-within .project__hint {
      opacity: 1;
      transform: none;
    }
  }
</style>
