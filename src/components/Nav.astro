---
import { nav, person } from "../data/site";
---
<header class="topbar" data-scrolled="false">
  <div class="bar">
    <a class="brand" href="#about" aria-label="Андреев Александр — наверх">{person.shortName}</a>
    <div class="bar__right">
      <nav class="nav" aria-label="Разделы">
        <button class="nav__menu" type="button" aria-expanded="false" aria-controls="nav-list">
          <span class="nav__menu-icon" aria-hidden="true"></span>
          Меню
        </button>
        <ul id="nav-list" class="nav__list">
          {nav.map((item) => (
            <li>
              <a class="nav__link" href={item.href} data-nav={item.href.slice(1)}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <button class="theme" type="button" aria-label="Включить тёмную тему" data-theme-toggle>
        <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
          <circle cx="10" cy="10" r="7.25" fill="none" stroke="currentColor" stroke-width="1.5" />
          <path d="M10 2.75a7.25 7.25 0 0 1 0 14.5z" fill="currentColor" />
        </svg>
      </button>
    </div>
  </div>
</header>

<style>
  .topbar {
    position: fixed;
    inset: 10px 0 auto;
    z-index: 50;
    padding-inline: calc(var(--gutter) - 10px);
    pointer-events: none;
  }
  .bar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    max-width: calc(var(--max) + 20px);
    height: 50px;
    margin-inline: auto;
    padding: 0 6px 0 10px;
    border: 1px solid transparent;
    border-radius: var(--r-node);
    pointer-events: auto;
    transition:
      background-color 0.3s ease,
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }
  .topbar[data-scrolled="true"] .bar {
    background: var(--paper);
    border-color: var(--rule);
    box-shadow: 0 10px 30px -24px rgb(0 0 0 / 0.45);
  }
  .brand {
    font-weight: 720;
    font-size: 15px;
    letter-spacing: -0.01em;
    text-decoration: none;
    padding: 6px 4px;
  }
  .bar__right {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .nav__list {
    display: flex;
    gap: 2px;
  }
  .nav__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 36px;
    padding-inline: 10px;
    border-radius: var(--r-chip);
    color: var(--graphite);
    font-size: 14px;
    font-weight: 560;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .nav__link::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--juice);
    transform: scale(0);
    margin-right: -13px;
    transition:
      transform 0.25s var(--ease-out),
      margin 0.25s var(--ease-out);
  }
  .nav__link:hover {
    color: var(--ink);
  }
  .nav__link[aria-current="true"] {
    color: var(--ink);
  }
  .nav__link[aria-current="true"]::before {
    transform: scale(1);
    margin-right: 0;
  }
  .nav__menu {
    display: none;
    align-items: center;
    gap: 8px;
    height: 36px;
    padding-inline: 10px;
    font-size: 14px;
    font-weight: 600;
  }
  .nav__menu-icon {
    position: relative;
    width: 14px;
    height: 8px;
    border-block: 1.5px solid currentColor;
    transition: transform 0.25s var(--ease-out);
  }
  .nav__menu[aria-expanded="true"] .nav__menu-icon {
    transform: scaleY(0.25);
  }
  .theme {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: var(--r-chip);
  }
  .theme svg {
    width: 19px;
    height: 19px;
    transition: transform 0.5s var(--ease-out);
  }
  :global([data-theme="dark"]) .theme svg {
    transform: rotate(180deg);
  }
  .theme:hover {
    background: var(--paper-2);
  }

  @media (max-width: 760px) {
    .nav__menu {
      display: inline-flex;
    }
    .nav__list {
      position: absolute;
      top: calc(100% + 6px);
      right: 0;
      flex-direction: column;
      min-width: 210px;
      padding: 6px;
      background: var(--paper);
      border: 1px solid var(--rule);
      border-radius: var(--r-node);
      box-shadow: var(--shadow);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-6px);
      transition:
        opacity 0.2s ease,
        transform 0.25s var(--ease-out),
        visibility 0s linear 0.25s;
    }
    .nav__list.is-open {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition:
        opacity 0.2s ease,
        transform 0.25s var(--ease-out);
    }
    .nav__link {
      width: 100%;
      height: 44px;
      font-size: 16px;
    }
    .topbar[data-scrolled="false"] .bar:has(.is-open) {
      background: var(--paper);
      border-color: var(--rule);
    }
  }
</style>

<script>
  import "../scripts/nav";
  import "../scripts/theme";
</script>
