---
import { person, links } from "../data/site";
import { typo } from "../lib/typo";
import HeroMap from "./HeroMap.astro";
import Arrow from "./Arrow.astro";

const rows = person.roleRows.map((role, r) => ({ role: [...role], name: [...person.nameRows[r]] }));
---
<section id="about" class="hero wrap" aria-labelledby="hero-title">
  <div class="hero__top">
  <h1 id="hero-title" class="hero__title">
    <span class="visually-hidden">{person.name} — Go Developer</span>
    <span class="swap" data-state="name" data-hero-swap aria-hidden="true">
      {rows.map((row, r) => (
        <span class="swap__row" style={`--row:${r}`}>
          <span class="swap__layer swap__layer--role">
            {row.role.map((ch, i) => <span class="ch" style={`--i:${i}`}>{ch}</span>)}
          </span>
          <span class="swap__layer swap__layer--name">
            {row.name.map((ch, i) => <span class="ch" style={`--i:${i}`}>{ch}</span>)}
          </span>
        </span>
      ))}
    </span>
  </h1>
  <div class="hero__aside">
    <p class="hero__status"><span class="dot dot--live" aria-hidden="true"></span>{typo("Сейчас ищу стажировку в backend / Go")}</p>
    <ul class="hero__links">
      <li><a class="link-arrow" href={links.github} target="_blank" rel="noopener">GitHub <Arrow /></a></li>
      <li><a class="link-arrow" href={links.telegram} target="_blank" rel="noopener">Telegram <Arrow /></a></li>
    </ul>
  </div>
  </div>
  <div class="hero__bar" aria-hidden="true"><span></span></div>

  <div class="hero__info">
    <div class="hero__text">
      <p class="hero__lead">
        {typo("Пишу backend на Go: делаю HTTP API, работаю с базами данных и Docker. Стараюсь не ограничиваться учебными задачами, а доводить их до реальных проектов. Например, один из моих проектов каждый час автоматически ищет для меня подходящие стажировки.")}
      </p>
    </div>
    <HeroMap />
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(96px, 17vh, 176px);
    padding-bottom: clamp(56px, 8vw, 104px);
  }

  .hero__top {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 28px 40px;
  }
  .hero__aside {
    padding-top: 0.6em;
    max-width: 260px;
  }

  /* ---------- заголовок-перевёртыш ---------- */
  .hero__title {
    font-size: var(--fs-hero);
    font-weight: 800;
    line-height: 1;
  }
  .swap {
    display: block;
    width: fit-content;
    max-width: 100%;
    cursor: default;
    -webkit-tap-highlight-color: transparent;
    user-select: none;
  }
  .swap__row {
    display: grid;
    align-items: baseline;
    height: 0.92em;
    clip-path: inset(-0.14em -0.4em -0.3em -0.12em);
  }
  .swap__layer {
    grid-area: 1 / 1;
    display: flex;
    white-space: nowrap;
  }
  .swap__layer--role {
    font-family: var(--font-sans);
    font-weight: 800;
    letter-spacing: -0.05em;
    line-height: 0.92;
  }
  .swap__layer--name {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 0.7em;
    letter-spacing: -0.03em;
    line-height: 1.3143; /* 0.92em родителя в собственных единицах */
  }
  .ch {
    display: inline-block;
    transition: transform 0.56s cubic-bezier(0.76, 0, 0.18, 1);
    transition-delay: calc(var(--i) * 24ms + var(--row) * 70ms);
    will-change: transform;
  }
  .swap[data-state="name"] .swap__layer--role .ch {
    transform: translateY(-135%);
  }
  .swap[data-state="role"] .swap__layer--name .ch {
    transform: translateY(125%);
  }

  /* тангериновая полоса под заголовком: короткая для роли, во всю ширину для имени */
  .hero__bar {
    height: clamp(5px, 0.6vw, 8px);
    margin-top: clamp(14px, 2vw, 26px);
  }
  .hero__bar span {
    display: block;
    height: 100%;
    width: 100%;
    background: var(--juice);
    transform-origin: left center;
    transform: scaleX(0.12);
    transition: transform 0.7s cubic-bezier(0.76, 0, 0.18, 1) 0.08s;
  }
  .hero:has(.swap[data-state="name"]) .hero__bar span {
    transform: scaleX(1);
  }

  /* ---------- информация ---------- */
  .hero__info {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    row-gap: 48px;
    margin-top: clamp(36px, 5vw, 72px);
    align-items: start;
  }
  .hero__text {
    grid-column: 1 / span 5;
  }
  .hero__lead {
    font-size: var(--fs-lead);
    line-height: 1.45;
    max-width: 36ch;
    letter-spacing: -0.005em;
  }
  .hero__status {
    display: flex;
    align-items: baseline;
    gap: 12px;
    font-weight: 650;
    font-size: 17px;
    line-height: 1.35;
  }
  .hero__status .dot {
    translate: 0 -1px;
  }
  .hero__links {
    display: flex;
    gap: 24px;
    margin-top: 18px;
    padding-left: 20px;
    font-size: 15px;
  }
  @media (max-width: 1100px) {
    .hero__top {
      flex-direction: column-reverse;
    }
    .hero__aside {
      padding-top: 0;
      max-width: none;
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 12px 28px;
    }
    .hero__links {
      margin-top: 0;
      padding-left: 0;
    }
  }
  .hero__info > :global(.map) {
    grid-column: 7 / -1;
  }

  @media (max-width: 960px) {
    .hero__text {
      grid-column: 1 / span 7;
    }
    .hero__info > :global(.map) {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 640px) {
    .hero__text {
      grid-column: 1 / -1;
    }
  }
</style>

<script>
  import "../scripts/hero-swap";
</script>
