---
// Настоящие логотипы из simple-icons, в цвет текста. Декоративны: рядом всегда есть подпись.
import {
  siGo, siGit, siGithub, siDocker, siPostgresql, siSqlite, siTelegram,
  siPython, siFastapi, siSupabase, siGooglegemini,
} from "simple-icons";

const icons = {
  go: siGo, git: siGit, github: siGithub, docker: siDocker, postgresql: siPostgresql,
  sqlite: siSqlite, telegram: siTelegram, python: siPython, fastapi: siFastapi,
  supabase: siSupabase, googlegemini: siGooglegemini,
} as const;

export type LogoSlug = keyof typeof icons;

interface Props {
  slug: LogoSlug | string;
  class?: string;
}
const { slug, class: className } = Astro.props;
const icon = icons[slug as LogoSlug];
---
{icon && (
  <svg class={className} width="1em" height="1em" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
    <path d={icon.path} />
  </svg>
)}
