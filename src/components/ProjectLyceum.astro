---
import { repos, file } from "../data/site";
import { typo } from "../lib/typo";
import Arrow from "./Arrow.astro";
import Logo from "./Logo.astro";

// Иллюстрация того, что делает ExtractLog: строки внутри [start, end] попадают в результат,
// на строке с датой end чтение останавливается. Сам лог — пример входных данных.
const log = [
  { date: "18.12.2022", level: "INFO", msg: "service started", state: "skip" },
  { date: "19.12.2022", level: "WARN", msg: "retry #2", state: "take" },
  { date: "19.12.2022", level: "INFO", msg: "request ok", state: "take" },
  { date: "20.12.2022", level: "ERROR", msg: "timeout", state: "end" },
  { date: "21.12.2022", level: "INFO", msg: "not read", state: "after" },
];
---
<article id="project-01" class="project lyceum" aria-labelledby="p1-title">
  <div class="lyceum__text">
    <p class="project__num">01</p>
    <h3 id="p1-title" class="project__title">Yandex Lyceum — Go</h3>
    <p class="project__desc">
      {typo("Учебный репозиторий курса «Go: шаг за шагом». Функция ExtractLog читает лог построчно и возвращает записи между двумя датами; рядом — table-driven тест на сортировку и слияние срезов.")}
    </p>
    <ul class="tags" aria-label="Технологии">
      <li class="tag"><Logo slug="go" />Go</li>
      <li class="tag">Algorithms</li>
      <li class="tag">Problem Solving</li>
      <li class="tag">Testing</li>
    </ul>
    <div class="project__foot">
      <a class="link-arrow" href={repos.lyceum} target="_blank" rel="noopener">Репозиторий <Arrow /></a>
      <p class="project__meta"><span><b>ноя 2025 — янв 2026</b></span><span>main.go, main_test.go</span></p>
    </div>
  </div>

  <figure class="lyceum__visual">
    <div class="panel panel--lift logview">
      <p class="logview__call mono">
        <span class="k">func</span> ExtractLog(inputFileName <span class="t">string</span>, start, end <span class="t">time.Time</span>) ([]<span class="t">string</span>, <span class="t">error</span>)
      </p>
      <div class="logview__args mono" aria-hidden="true">
        <span>start = <b>19.12.2022</b></span>
        <span>end = <b>20.12.2022</b></span>
      </div>
      <ol class="logview__lines mono">
        {log.map((l) => (
          <li class:list={["line", `line--${l.state}`]}>
            <span class="line__date">{l.date}</span>
            <span class="line__lvl">{l.level}</span>
            <span class="line__msg">{l.msg}</span>
            <span class="line__note">
              {l.state === "skip" && "раньше start"}
              {l.state === "take" && "в результат"}
              {l.state === "end" && "= end → break"}
              {l.state === "after" && "не читается"}
            </span>
          </li>
        ))}
      </ol>
      <p class="logview__result mono">→ []string, 3 строки</p>
    </div>
    <figcaption class="project__hint">
      bufio.Scanner · time.Parse("02.01.2006") · <a href={file(repos.lyceum, "main.go")} target="_blank" rel="noopener">main.go</a> · пример входных данных
    </figcaption>
  </figure>
</article>

<style>
  .lyceum__text {
    grid-column: 1 / span 5;
  }
  .lyceum__visual {
    grid-column: 7 / -1;
    align-self: center;
    min-width: 0;
  }
  .logview {
    padding: clamp(18px, 2.4vw, 28px);
    background: var(--paper-2);
    overflow: hidden;
  }
  .logview__call {
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--graphite);
    overflow-wrap: anywhere;
  }
  .logview__call .k {
    color: var(--juice-ink);
    font-weight: 600;
  }
  .logview__call .t {
    color: var(--ink);
  }
  .logview__args {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin-top: 14px;
    font-size: 12.5px;
    color: var(--graphite);
  }
  .logview__args b {
    color: var(--ink);
    font-weight: 600;
  }
  .logview__lines {
    margin-top: 16px;
    border-top: 1px solid var(--rule-strong);
  }
  .line {
    position: relative;
    display: grid;
    grid-template-columns: 10.5ch 5.5ch minmax(0, 1fr) auto;
    gap: 10px;
    align-items: center;
    padding: 9px 10px 9px 14px;
    border-bottom: 1px solid var(--rule);
    font-size: 13px;
    transition: background-color 0.3s ease;
  }
  .line::before {
    content: "";
    position: absolute;
    left: 0;
    top: 6px;
    bottom: 6px;
    width: 3px;
    border-radius: 2px;
    background: var(--juice);
    transform: scaleY(0);
    transition: transform 0.35s var(--ease-out);
  }
  .line--take::before,
  .line--end::before {
    transform: none;
  }
  .line--take,
  .line--end {
    background: color-mix(in srgb, var(--juice) 10%, transparent);
  }
  .line--skip,
  .line--after {
    color: var(--graphite);
  }
  .line--after {
    opacity: 0.55;
    text-decoration: line-through;
    text-decoration-color: var(--rule-strong);
  }
  .line__lvl {
    font-weight: 600;
  }
  .line__msg {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .line__note {
    font-family: var(--font-sans);
    font-size: 12px;
    color: var(--graphite);
    text-decoration: none;
    white-space: nowrap;
  }
  .line--end .line__note {
    color: var(--juice-ink);
    font-weight: 600;
  }
  .logview__result {
    margin-top: 14px;
    font-size: 12.5px;
    font-weight: 600;
  }
  .lyceum :global(.project__hint a) {
    color: inherit;
  }

  @media (max-width: 960px) {
    .lyceum__text,
    .lyceum__visual {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 520px) {
    .line {
      grid-template-columns: 10.5ch minmax(0, 1fr) auto;
      gap: 8px;
    }
    .line__lvl {
      display: none;
    }
  }
</style>
